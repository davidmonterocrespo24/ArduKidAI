# Copy to .env for local development. Never commit the real .env.

# Agent mode. "real" calls Gemini 3 via Vertex AI; "mock" returns a scripted
# response so curl tests work without GCP credentials.
ARDUKID_AGENT_MODE=mock

# Vertex AI configuration (only used when ARDUKID_AGENT_MODE=real)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
ARDUKID_GEMINI_MODEL=gemini-3-pro

# Service-account credentials for local dev. In Cloud Run we use
# Application Default Credentials and this is unset.
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json

# arduino-cli configuration
ARDUKID_FQBN=arduino:avr:uno
ARDUKID_ARDUINO_CLI=arduino-cli

# CORS - comma-separated list of frontend origins allowed to call this backend.
ARDUKID_CORS_ORIGINS=http://localhost:5173

# MongoDB Atlas. Empty -> backend falls back to in-memory stores for catalog,
# projects, and examples. Set in production / once the Atlas M0 cluster is up.
MONGODB_URI=
MONGODB_DB=ardukid

# Toggle the MongoDB MCP server sidecar. When MCP_ENABLED=true, the agent
# routes its read/search/save tools through the MongoDB MCP server instead of
# calling the local Motor client directly. Off by default until phase 5 deploy.
MCP_ENABLED=false
MCP_SERVER_URL=http://localhost:3030

# Auth. Anonymous play works without anything set here. Logged-in users get
# their projects scoped to their account. CHANGE the JWT secret in production.
JWT_SECRET=ardukid-local-dev-only-change-me
JWT_TTL_HOURS=336
