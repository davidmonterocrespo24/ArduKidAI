# The A2UI renderer set ships an internally over-strict peer range:
# @a2ui/markdown-it@0.0.4 pins @a2ui/web_core@^0.9.2, yet @a2ui/react@0.10.0
# ships against @a2ui/web_core@^0.10.0. The mismatch is cosmetic (markdown-it
# is a thin markdown-it wrapper), so we relax peer resolution for the whole
# project. Keep this in sync with the Dockerfile npm-ci steps.
legacy-peer-deps=true
