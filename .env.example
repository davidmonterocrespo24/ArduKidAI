# Copy to .env for `docker compose up`. Do NOT commit the real .env.

# Agent mode. "mock" runs the scripted demo client (no GCP creds needed);
# flip to "real" once GOOGLE_CLOUD_PROJECT and Application Default
# Credentials are configured for the backend container.
ARDUKID_AGENT_MODE=mock

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
ARDUKID_GEMINI_MODEL=gemini-3-pro

# Comma-separated origins the backend allows. The frontend domain ends up
# here so the SPA can call /api directly through the reverse proxy.
ARDUKID_CORS_ORIGINS=https://ArduKidAI.moontero.com,http://localhost:5173

# MongoDB Atlas (optional). When empty the backend uses in-memory stores
# for catalog/projects/examples and the deterministic embedding fallback.
MONGODB_URI=
MONGODB_DB=ardukid

# MongoDB MCP server sidecar. Bring it up with the `mcp` compose profile.
MCP_ENABLED=false
MCP_SERVER_URL=http://mongo-mcp:3030

# Auth - MUST be replaced with a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=336
